{
  "expo": {
    "name": "Duet",
    "slug": "duet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/duet-app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "duet",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/duet-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.duet.mobile"
    },
    "android": {
      "package": "app.duet.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/duet-icon-foreground.png",
        "backgroundColor": "#FFF8F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFF8F3",
      "barStyle": "dark-content",
      "visible": "sticky-immersive"
    },
    "web": {
      "favicon": "./assets/duet-icon-foreground.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F3",
          "image": "./assets/duet-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "absolute",
          "legacyVisible": "sticky-immersive"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E85D75",
          "defaultChannel": "date-reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Duet использует фото, чтобы добавить их к желанию."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "position": "absolute",
        "legacyVisible": "sticky-immersive"
      },
      "eas": {
        "projectId": "8ae6ef47-e855-4faf-9e8e-b491b9d0d8ba"
      }
    },
    "owner": "gasello"
  }
}
