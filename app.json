{
  "expo": {
    "name": "Duet",
    "slug": "duet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/duet-app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "duet",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.duet.mobile"
    },
    "android": {
      "allowBackup": false,
      "package": "app.duet.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/duet-icon-foreground.png",
        "backgroundColor": "#FFF8F3"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/duet-icon-foreground.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-r8-production",
      [
        "expo-awesome-app-icon",
        {
          "icons": {
            "emerald": {
              "ios": {
                "light": "./assets/duet-app-icon-emerald.png"
              },
              "android": {
                "foregroundImage": "./assets/duet-icon-foreground-emerald.png",
                "backgroundColor": "#F6FBF8"
              }
            },
            "honey": {
              "ios": {
                "light": "./assets/duet-app-icon-honey.png"
              },
              "android": {
                "foregroundImage": "./assets/duet-icon-foreground-honey.png",
                "backgroundColor": "#FFF8E6"
              }
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F6",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E85D75",
          "defaultChannel": "date-reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение использует фото, чтобы добавить их к желанию.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ae6ef47-e855-4faf-9e8e-b491b9d0d8ba"
      }
    },
    "owner": "gasello"
  }
}
