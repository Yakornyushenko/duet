{
  "expo": {
    "name": "Duet",
    "slug": "duet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/duet-app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "duet",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.duet.mobile"
    },
    "android": {
      "allowBackup": false,
      "package": "app.duet.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/duet-icon-foreground.png",
        "backgroundColor": "#FFF8F3"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/duet-icon-foreground.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F3",
          "image": "./assets/duet-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E85D75",
          "defaultChannel": "date-reminders",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Duet использует фото, чтобы добавить их к желанию.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ae6ef47-e855-4faf-9e8e-b491b9d0d8ba"
      }
    },
    "owner": "gasello"
  }
}
